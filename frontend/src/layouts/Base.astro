---
import "@/styles/globals.css";
import "sonner/dist/styles.css";
import { getMaintenanceStatus } from "@/actions-handlers/system/maintenance";
import { getCurrentProfile } from "@/lib/auth";
import { SiteHeaderClient } from "@/components/site-header-client";
import { SiteFooter } from "@/components/layout/footer";
import { Toaster } from "sonner";
import { CombinedWidgetClient } from "@/components/features/combined/CombinedWidgetClient";
import { AccessibilityWidget } from "@/components/features/accessibility/AccessibilityWidget";
import { ScrollToTopButton } from "@/components/common/scroll-to-top";
import { AuthRedirectListener } from "@/components/auth/auth-redirect-listener";
import { MaintenanceSyncListener } from "@/components/layout/maintenance-sync-listener";
import { ClientRouter } from "astro:transitions";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import GoogleAnalyticsNoscript from "@/components/analytics/GoogleAnalyticsNoscript.astro";

interface Props {
  title?: string;
  description?: string;
}

const appUrl = "https://ptsp.kemenag-baritoutara.com";
const {
  title = "PTSP Kemenag Barito Utara",
  description = "Portal resmi layanan administrasi keagamaan (PTSP) Kantor Kementerian Agama Kabupaten Barito Utara. Proses mudah, transparan, dan akuntabel.",
} = Astro.props;

const url = Astro.url;
const pathname = url.pathname;

// ConditionalShell logic (dari Next.js conditional-shell.tsx)
const isAdmin = pathname.startsWith("/admin");
const isLengkapiProfil = pathname.startsWith("/lengkapi-profil");
const isLengkapiWaPegawai = pathname.startsWith("/lengkapi-wa-pegawai");
const isBarcode = pathname === "/barcode" || pathname.endsWith("/barcode");
const isLegalPage =
  pathname === "/syarat-ketentuan" ||
  pathname.startsWith("/syarat-ketentuan/") ||
  pathname === "/kebijakan-privasi" ||
  pathname.startsWith("/kebijakan-privasi/");
const isBareRoute = isAdmin || isLengkapiProfil || isLengkapiWaPegawai || isBarcode || isLegalPage;

const isDashboard =
  pathname.startsWith("/dashboard") ||
  pathname.startsWith("/pegawai") ||
  pathname.startsWith("/masyarakat");

// Bypass pengecekan maintenance pada panel admin & dashboard agar navigasi instan
const maintenance = (isBareRoute || isDashboard)
  ? { enabled: false, message: "", startedAt: null, startedBy: null, aiChatEnabled: true }
  : await getMaintenanceStatus();

let profile: any = null;
try {
  profile = await getCurrentProfile(Astro);
} catch {
  profile = null;
}
const isMaintenance = pathname === "/maintenance";
const isAuthPage =
  pathname.startsWith("/login") ||
  pathname.startsWith("/register") ||
  pathname.startsWith("/forgot-password");

const showHeader = !isBareRoute && !isDashboard && !isMaintenance && !isAuthPage;
const showFooter = !isBareRoute && !isAuthPage && !isMaintenance;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${appUrl}/#website`,
      url: appUrl,
      name: "PTSP Kemenag Barito Utara",
      alternateName: ["PTSP Barito Utara", "Kemenag Barito Utara"],
      publisher: {
        "@id": `${appUrl}/#organization`,
      },
    },
    {
      "@type": "GovernmentOrganization",
      "@id": `${appUrl}/#organization`,
      name: "Kantor Kementerian Agama Kabupaten Barito Utara",
      url: appUrl,
      logo: `${appUrl}/kemenag-512.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Jl. Ahmad Yani No. 126",
        addressLocality: "Muara Teweh",
        addressRegion: "Kalimantan Tengah",
        postalCode: "73811",
        addressCountry: "ID",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+6251921269",
        contactType: "customer service",
      },
    },
  ],
};

const pageTitle =
  title === "PTSP Kemenag Barito Utara"
    ? title
    : `${title} | PTSP Kemenag Barito Utara`;
---

<!doctype html>
<html
  lang="id"
  style={{ "--font-jakarta": "'Plus Jakarta Sans', sans-serif" } as any}
  class="dark:bg-slate-950"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <!-- Google Fonts API: Plus Jakarta Sans (Hanya 1 Font Tunggal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />

    <!-- Resource & Priority Hints (GTM, GA4, LCP Hero Preload) -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    {pathname === "/" && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        href="/kantor-kemenag-hd.webp?v=2026"
        fetchpriority="high"
      />
    )}

    {/* Google Analytics & Tag Manager (Aktif hanya di luar panel admin) */}
    {!isAdmin && <GoogleAnalytics />}
    <meta name="description" content={description} />
    <meta name="application-name" content="PTSP Kemenag Barito Utara" />
    <meta name="keywords" content="Kemenag Barito Utara, PTSP Kemenag, Layanan Agama Barut, Pelayanan Satu Pintu, Muara Teweh, Administrasi Keagamaan" />
    <meta name="author" content="Kemenag Barito Utara" />
    <meta name="creator" content="Kemenag Barito Utara" />
    <meta name="publisher" content="Kemenag Barito Utara" />
    <!-- Enterprise PWA & Standalone Configuration -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#064e3b" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#022c22" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PTSP Barut" />
    <meta name="msapplication-TileColor" content="#064e3b" />
    <meta name="msapplication-TileImage" content="/kemenag-192.png" />
    <meta name="msapplication-tap-highlight" content="no" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={`${appUrl}${pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PTSP Kemenag Barito Utara" />
    <meta property="og:title" content="Pelayanan Terpadu Satu Pintu (PTSP) - Kemenag Barito Utara" />
    <meta property="og:description" content="Portal resmi layanan administrasi keagamaan (PTSP) Kantor Kementerian Agama Kabupaten Barito Utara." />
    <meta property="og:url" content={url.href} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="PTSP Kemenag Barito Utara" />
    <meta name="twitter:description" content="Portal resmi layanan administrasi keagamaan Kantor Kementerian Agama Kabupaten Barito Utara." />
    <meta name="twitter:creator" content="@kemenag_barut" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/kemenag.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/kemenag-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/kemenag-512.png" />
    <link rel="shortcut icon" href="/kemenag-192.png" />
    <link rel="apple-touch-icon" href="/kemenag-512.png" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark") {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Enterprise Service Worker Registration -->
    <script is:inline>
      if (typeof window !== "undefined" && "serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker
            .register("/sw.js", { scope: "/" })
            .then(function (reg) {
              reg.addEventListener("updatefound", function () {
                var newWorker = reg.installing;
                if (newWorker) {
                  newWorker.addEventListener("statechange", function () {
                    if (newWorker.state === "installed" && navigator.serviceWorker.controller) {
                      console.log("[PWA] Update baru tersedia.");
                    }
                  });
                }
              });
            })
            .catch(function (err) {
              console.warn("[PWA] Registrasi Service Worker gagal:", err);
            });
        });

        window.addEventListener("beforeinstallprompt", function (e) {
          window.deferredPrompt = e;
          window.dispatchEvent(new CustomEvent("pwa-installable"));
        });

        window.addEventListener("appinstalled", function () {
          window.deferredPrompt = null;
        });
      }
    </script>
  </head>
  <body class="text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    {!isAdmin && <GoogleAnalyticsNoscript />}
    <div class="flex min-h-dvh flex-col">
      {
        showHeader && (
          <SiteHeaderClient client:load profile={profile} pathname={pathname} />
        )
      }
      <main class="relative flex w-full flex-1 flex-col">
        <slot />
      </main>
      {
        showFooter &&
          (isDashboard ? (
            <footer class="hidden md:block border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-4 text-center text-[11px] font-medium text-slate-400">
              © {new Date().getFullYear()} PTSP Kantor Kementerian Agama Kab. Barito Utara
            </footer>
          ) : (
            <SiteFooter client:load />
          ))
      }
      {!isAdmin && (
        <Toaster
          client:load
          transition:persist="ptsp-toaster"
          position="top-center"
          richColors
          duration={3000}
          style={{ zIndex: 99999999 }}
          toastOptions={{
            style: {
              borderRadius: "16px",
              boxShadow:
                "0 10px 30px -4px rgba(15, 23, 42, 0.15), 0 4px 12px -2px rgba(15, 23, 42, 0.08)",
              border: "1px solid rgba(226, 232, 240, 0.8)",
              padding: "12px 18px",
              fontSize: "13px",
              fontWeight: "600",
              zIndex: 99999999,
            },
            className: "text-[13px] font-sans antialiased",
          }}
        />
      )}
      {!isMaintenance && !isAdmin && !isDashboard && !isLegalPage && (
        <>
          <CombinedWidgetClient client:load initialEnabled={maintenance.aiChatEnabled} />
          <ScrollToTopButton client:load />
        </>
      )}
      {!isMaintenance && !isLegalPage && (
        <AccessibilityWidget client:load />
      )}
      <AuthRedirectListener client:load />
      <MaintenanceSyncListener client:load />
    </div>
  </body>
</html>