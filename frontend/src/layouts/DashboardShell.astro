---
import Base from "@/layouts/Base.astro";
import { DashboardSidebar } from "@/components/dashboard/sidebar";
import { PageTransition } from "@/components/ui/page-transition";

interface Props {
  title: string;
  description?: string;
  mode?: "admin" | "pegawai" | "user";
  userNip?: string;
}

const { title, description, mode = "user", userNip = "" } = Astro.props;
---

<Base title={title} description={description}>
  <div class="mx-auto w-full px-4 py-4 sm:px-6 sm:py-6 lg:px-8 lg:py-8">
    <div class="flex flex-col md:flex-row items-start gap-5 lg:gap-6">
      <div class="w-full md:w-[240px] lg:w-[260px] shrink-0 sticky top-0 md:top-20 z-40 self-start">
        <DashboardSidebar client:load mode={mode} userNip={userNip} />
      </div>
      <main class="min-w-0 flex-1 w-full">
        <PageTransition client:load>
          <slot />
        </PageTransition>
      </main>
    </div>
  </div>
</Base>