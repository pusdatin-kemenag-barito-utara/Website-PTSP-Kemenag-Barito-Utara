---
import Base from "@/layouts/Base.astro";
import { DashboardSidebar } from "@/components/dashboard/sidebar";
import { PageTransition } from "@/components/ui/page-transition";

interface Props {
  title: string;
  description?: string;
  mode?: "admin" | "pegawai" | "user";
  userNip?: string;
}

const { title, description, mode = "user", userNip = "" } = Astro.props;
---

<Base title={title} description={description}>
  <div class="block md:flex md:flex-row min-h-screen bg-slate-50 dark:bg-slate-950">
    <div class="w-full md:w-[260px] lg:w-[280px] shrink-0 sticky top-0 z-40 md:h-screen self-start">
      <DashboardSidebar client:load mode={mode} userNip={userNip} />
    </div>
    <main class="min-w-0 flex-1 w-full p-4 pt-[72px] sm:p-6 sm:pt-[80px] md:p-6 lg:p-8 overflow-x-hidden">
      <PageTransition client:load>
        <slot />
      </PageTransition>
    </main>
  </div>
</Base>