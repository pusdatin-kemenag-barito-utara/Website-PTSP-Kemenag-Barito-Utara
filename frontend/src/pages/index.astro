---
import Base from "@/layouts/Base.astro";
import { HomeHero } from "@/components/home/hero";
import { HomeSambutanKepala } from "@/components/home/sambutan";
import { HomeAlurPengajuanMobile } from "@/components/home/alur-pengajuan-mobile";
import { HomeServiceCatalogSection } from "@/components/home/service-catalog";
import { HomeVideoProfile } from "@/components/home/video-profile";
import { BannerModal } from "@/components/home/banner-modal";
import { getPublicServices, getHomeVideos } from "@/lib/queries";

const query = Astro.url.searchParams;
if (query.get("code")) {
  const params = new URLSearchParams();
  query.forEach((value, key) => params.append(key, value));
  return Astro.redirect(`/auth/callback?${params.toString()}`);
}

const [services, homeVideosData] = await Promise.all([
  getPublicServices(),
  getHomeVideos(),
]);

const { videos, totalCount } = homeVideosData;
---

<Base>
  <div class="w-full overflow-x-hidden relative">
    <BannerModal client:load />
    <HomeHero client:load />
    <HomeSambutanKepala client:load />
    <HomeAlurPengajuanMobile client:load />

    <div class="relative w-full h-8 bg-gradient-to-b from-[#f8fafc] via-[#f8fafc]/50 to-white dark:from-slate-950 dark:via-slate-950/50 dark:to-slate-950 flex items-center justify-center overflow-hidden transition-colors duration-300">
      <div class="w-full h-[3px] bg-gradient-to-r from-transparent via-emerald-500/80 dark:via-emerald-400/90 to-transparent shadow-[0_0_12px_rgba(16,185,129,0.6)]" />
      <div class="absolute w-3/4 max-w-5xl h-8 bg-emerald-500/20 dark:bg-emerald-400/25 blur-2xl rounded-full pointer-events-none" />
    </div>

    <HomeServiceCatalogSection client:load services={services} />

    <div class="relative w-full h-8 bg-gradient-to-b from-white via-white/50 to-[#f8fafc] dark:from-slate-950 dark:via-slate-950/50 dark:to-slate-950 flex items-center justify-center overflow-hidden transition-colors duration-300">
      <div class="w-full h-[3px] bg-gradient-to-r from-transparent via-emerald-500/80 dark:via-emerald-400/90 to-transparent shadow-[0_0_12px_rgba(16,185,129,0.6)]" />
      <div class="absolute w-3/4 max-w-5xl h-8 bg-emerald-500/20 dark:bg-emerald-400/25 blur-2xl rounded-full pointer-events-none" />
    </div>

    <HomeVideoProfile client:load videos={videos} totalCount={totalCount} />
  </div>
</Base>