---
import Base from "@/layouts/Base.astro";
import { HomeHero } from "@/components/home/hero";
import { HomeAlurPelayanan } from "@/components/home/alur-pelayanan";
import { HomeSambutanKepala } from "@/components/home/sambutan";
import { HomeServiceCatalogSection } from "@/components/home/service-catalog";
import { HomeVideoProfile } from "@/components/home/video-profile";
import { BannerModal } from "@/components/home/banner-modal";
import { getPublicServices, getHomeVideos } from "@/lib/queries";
import { getCurrentProfile } from "@/lib/auth";

const query = Astro.url.searchParams;
if (query.get("code")) {
  const params = new URLSearchParams();
  query.forEach((value, key) => params.append(key, value));
  return Astro.redirect(`/auth/callback?${params.toString()}`);
}

let profile: any = null;
try {
  profile = await getCurrentProfile(Astro);
} catch {}

const [services, homeVideosData] = await Promise.all([
  getPublicServices(),
  getHomeVideos(),
]);

const { videos, totalCount } = homeVideosData;
---

<Base>
  <div class="w-full overflow-x-hidden relative">
    <BannerModal client:load />
    <HomeHero client:load profile={profile} />
    <HomeAlurPelayanan client:load />
    <HomeSambutanKepala client:load />
    <HomeServiceCatalogSection client:load services={services} />
    <HomeVideoProfile client:load videos={videos} totalCount={totalCount} />
  </div>
</Base>