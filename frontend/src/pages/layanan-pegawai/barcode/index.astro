---
import Base from "@/layouts/Base.astro";
import { BarcodeDisplay } from "@/components/barcode/barcode-display";
---

<Base title="Barcode Katalog Layanan Pegawai">
  <BarcodeDisplay
    client:load
    qrUrl="https://ptsp.kemenag-baritoutara.com/layanan-pegawai"
    title="Katalog Layanan Pegawai"
    subtitle="PTSP Kemenag Barito Utara"
    backHref="/layanan-pegawai"
    backLabel="Kembali ke Layanan Pegawai"
    scanText="Scan untuk Melihat Layanan Pegawai"
    description="Arahkan kamera HP Anda ke QR Code di atas untuk melihat katalog layanan pegawai PTSP Kemenag Barito Utara."
    downloadFilename="barcode-layanan-pegawai-ptsp-kemenag.png"
    footerTitle="Pelayanan Terpadu Satu Pintu (PTSP)"
    footerSubtitle="Kementerian Agama Kabupaten Barito Utara"
    footerUrl="https://ptsp.kemenag-baritoutara.com/layanan-pegawai"
  />
</Base>