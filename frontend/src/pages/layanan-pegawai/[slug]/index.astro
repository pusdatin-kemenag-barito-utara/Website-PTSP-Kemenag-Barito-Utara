---
import Base from "@/layouts/Base.astro";
import { ServiceDetailPegawaiView } from "@/views/service-detail-pegawai";
import { getServiceBySlug } from "@/lib/queries";
import { notFound } from "@/lib/next-compat/navigation";

const { slug } = Astro.params;
const q = Astro.url.searchParams;
const initialItemId = q.get("item") ?? undefined;

const service = await getServiceBySlug(slug ?? "");

if (!service) {
  notFound();
}
---

<Base title={service.name} description={service.description || "Detail layanan pegawai PTSP Kemenag Barito Utara"}>
  <ServiceDetailPegawaiView client:load service={service} initialItemId={initialItemId} />
</Base>