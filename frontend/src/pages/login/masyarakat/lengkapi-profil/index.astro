---
import Base from "@/layouts/Base.astro";
import { LengkapiProfilPemohonView } from "@/views/lengkapi-profil-pemohon";
import { getCurrentUser } from "@/lib/auth";

const user = await getCurrentUser(Astro);

if (!user) {
  return Astro.redirect("/login/masyarakat");
}

const token = Astro.cookies.get("ptsp-auth-access-token")?.value || "";
const initialUser = {
  id: user.id,
  email: user.email ?? "",
  name: user.user_metadata?.full_name || user.user_metadata?.name || "",
  avatarUrl: user.user_metadata?.avatar_url || "",
  token,
};
---

<Base
  title="Lengkapi Data Pemohon"
  description="Lengkapi data profil pemohon untuk masuk ke portal layanan PTSP."
>
  <LengkapiProfilPemohonView client:load initialUser={initialUser} />
</Base>