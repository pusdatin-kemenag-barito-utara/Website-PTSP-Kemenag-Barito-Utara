---
import { getCurrentUser, getCurrentProfile } from "@/lib/auth";
import { isAdminRole } from "@/lib/constants";

const q = Astro.url.searchParams;
const callbackUrl = q.get("callbackUrl");

const user = await getCurrentUser(Astro);
if (user) {
  if (callbackUrl) {
    return Astro.redirect(callbackUrl);
  }
  const profile = await getCurrentProfile(Astro);
  const role = profile?.role || user.user_metadata?.role;
  if (isAdminRole(role) || role === "super_admin") {
    return Astro.redirect("/admin");
  } else if (role === "pegawai") {
    return Astro.redirect("/pegawai");
  } else {
    return Astro.redirect("/masyarakat");
  }
}

const cbQuery = callbackUrl
  ? `?callbackUrl=${encodeURIComponent(callbackUrl)}`
  : "";
return Astro.redirect(`/login/masyarakat${cbQuery}`);
---