---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { requireAuth } from "@/lib/auth";
import { fetchAPI } from "@/lib/api";
import { Card } from "@/components/ui/card";

import { RequestsHeader } from "./_components/requests-header";
import { RequestsMobileList } from "./_components/requests-mobile-list";
import { RequestsDesktopTable } from "./_components/requests-desktop-table";

const profile = await requireAuth(false, Astro);

let requests: any[] = [];
try {
  const res = await fetchAPI<any>(`/requests?userId=${encodeURIComponent(profile.id)}`);
  if (res && res.data && Array.isArray(res.data)) {
    requests = res.data;
  }
} catch (err) {
  console.error("Failed to fetch requests from Golang API:", err);
}
---

<DashboardShell
  title="Pengajuan Saya"
  description={`Daftar pengajuan ${profile.fullName}`}
>
  <div class="space-y-6 md:space-y-8 animate-in fade-in duration-700">
    <RequestsHeader client:load />

    <Card class="overflow-hidden border-none shadow-2xl shadow-slate-200/60 rounded-2xl sm:rounded-[2rem] bg-white dark:bg-slate-900">
      <div class="block md:hidden">
        <RequestsMobileList client:load requests={requests} />
      </div>

      <div class="hidden md:block">
        <RequestsDesktopTable client:load requests={requests} />
      </div>
    </Card>
  </div>
</DashboardShell>