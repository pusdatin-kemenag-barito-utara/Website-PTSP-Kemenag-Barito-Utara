---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { requireAuth } from "@/lib/auth";
import { fetchAPI } from "@/lib/api";
import { RequestsView } from "./_components/requests-view";
import { Plus } from "lucide-react";

const profile = await requireAuth(false, Astro);

let requests: any[] = [];
try {
  const res = await fetchAPI<any>(`/requests?userId=${encodeURIComponent(profile.id)}`);
  if (res && res.data && Array.isArray(res.data)) {
    requests = res.data;
  }
} catch (err) {
  console.error("Failed to fetch requests from Golang API:", err);
}
---

<DashboardShell
  title="Riwayat Pengajuan"
  description={`Daftar riwayat permohonan layanan ${profile.fullName}`}
>
  <div class="space-y-4 sm:space-y-5 animate-in fade-in duration-300">
    <!-- Clean Minimalist Header -->
    <div class="flex items-center justify-between pb-0.5">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          Riwayat Pengajuan
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Pantau status dan kelola berkas permohonan Anda
        </p>
      </div>

      <a
        href="/masyarakat/pengajuan/baru"
        class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm px-4 py-2.5 shadow-xs transition-all active:scale-95 shrink-0"
      >
        <Plus className="h-4 w-4" />
        <span>Buat Pengajuan Baru</span>
      </a>
    </div>

    <!-- Clean, Modern & Interactive Requests View -->
    <RequestsView client:load requests={requests} userId={profile.id} />
  </div>
</DashboardShell>