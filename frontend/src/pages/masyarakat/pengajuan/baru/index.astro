---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { NewRequestForm } from "@/components/forms/new-request-form";
import { getPublicServiceCatalog } from "@/lib/queries";
import { requireAuth } from "@/lib/auth";
import { Sparkles, ArrowLeft } from "lucide-react";
import Link from "@/lib/next-compat/link";

const profile = await requireAuth(false, Astro);
const catalog = await getPublicServiceCatalog();
---

<DashboardShell
  title="Buat Pengajuan Baru"
  description="Pilih unit layanan dan lengkapi data permohonan Anda"
>
  <div class="space-y-5 md:space-y-6 animate-in fade-in duration-500">
    <!-- Banner Header Halaman -->
    <section class="relative overflow-hidden rounded-[2rem] sm:rounded-[2.25rem] bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-900 dark:from-slate-900 dark:via-slate-900 dark:to-emerald-950/80 p-6 sm:p-8 md:p-10 text-white shadow-xl dark:shadow-none border border-emerald-800/50 dark:border-slate-800 transition-colors duration-300">
      <!-- Subtle Background Radial Glow -->
      <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-emerald-500/15 dark:bg-emerald-500/10 blur-3xl pointer-events-none" />

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 dark:bg-emerald-950/80 border border-white/20 dark:border-emerald-800/60 px-3.5 py-1 backdrop-blur-md">
            <Sparkles client:load class="h-3.5 w-3.5 text-emerald-300" />
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-200 dark:text-emerald-300">
              Formulir Pelayanan Publik
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
            Buat Pengajuan Baru
          </h1>

          <p class="text-xs sm:text-sm font-medium text-emerald-100/80 dark:text-slate-300 leading-relaxed">
            Pilih unit layanan dan lengkapi data permohonan Anda secara mudah, transparan, dan realtime.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="/masyarakat/pengajuan"
            class="inline-flex items-center gap-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm px-4 py-2.5 backdrop-blur-md border border-white/20 transition-all hover:scale-[1.02] active:scale-95"
          >
            <ArrowLeft class="h-4 w-4" />
            <span>Kembali ke Riwayat</span>
          </a>
        </div>
      </div>
    </section>

    <NewRequestForm client:load catalog={catalog} profile={profile} />
  </div>
</DashboardShell>