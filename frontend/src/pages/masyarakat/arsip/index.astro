---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { requireAuth } from "@/lib/auth";
import { fetchAPI } from "@/lib/api";
import { ArchiveClient } from "./_components/archive-client";

const profile = await requireAuth(false, Astro);

let documents: any[] = [];
try {
  const res = await fetchAPI<any>(`/requests/archive?userId=${encodeURIComponent(profile.id)}`);
  if (res && res.data && Array.isArray(res.data)) {
    documents = res.data;
  }
} catch (err) {
  console.error("Failed to fetch user archive from Golang API:", err);
}
---

<DashboardShell
  title="Arsip Dokumen"
  description={`Arsip dokumen ${profile.fullName}`}
>
  <div class="space-y-6 md:space-y-8 animate-in fade-in duration-700">
    <ArchiveClient client:load initialDocuments={documents} />
  </div>
</DashboardShell>