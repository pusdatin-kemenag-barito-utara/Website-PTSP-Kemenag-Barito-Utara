---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { ArrowLeft } from "lucide-react";
import { getServiceBySlug, getServiceCatalog } from "@/lib/queries";
import { PegawaiUsulPensiunForm } from "@/components/forms/pegawai/pegawai-usul-pensiun-form";
import { requireAuth, getCurrentProfile } from "@/lib/auth";
import { notFound } from "@/lib/next-compat/navigation";

await requireAuth(false, Astro);

const slug = "usul-pensiun";
const service = await getServiceBySlug(slug);

if (!service) {
  notFound();
}

const currentProfile = await getCurrentProfile(Astro);
const userNip = currentProfile?.email?.split("@")[0] || "";
const catalog = await getServiceCatalog();
---

<DashboardShell
  title={service.name}
  description={service.description || "Formulir Usulan Pensiun ASN"}
  mode="pegawai"
  userNip={userNip}
>
  <div class="w-full space-y-4 animate-in fade-in slide-in-from-bottom-3 duration-300">
    <div>
      <a
        href="/pegawai/layanan/ajukan"
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-emerald-600 transition-colors mb-2"
      >
        <ArrowLeft className="h-4 w-4" />
        Kembali ke Daftar Layanan
      </a>
    </div>

    <PegawaiUsulPensiunForm
      client:load
      catalog={catalog}
      profile={currentProfile}
      redirectPathPrefix="/pegawai/layanan/riwayat"
      lockedServiceId={String(service.id)}
    />
  </div>
</DashboardShell>
