---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { AjukanLayananView } from "@/views/pegawai/ajukan-layanan";
import { getCurrentUser, getCurrentProfile } from "@/lib/auth";
import { fetchAPI } from "@/lib/api";

await getCurrentUser();

let services: any[] = [];
try {
  const res = await fetchAPI<any>("/services");
  services = (res?.data || []).filter((s: any) => s.category === "asn");
} catch {
  services = [];
}

const profile = await getCurrentProfile();
const userNip = profile?.email?.split("@")[0] || "";
---

<DashboardShell
  title="Ajukan Layanan ASN"
  description="Portal layanan kepegawaian mandiri"
  mode="pegawai"
  userNip={userNip}
>
  <AjukanLayananView client:load services={services} />
</DashboardShell>