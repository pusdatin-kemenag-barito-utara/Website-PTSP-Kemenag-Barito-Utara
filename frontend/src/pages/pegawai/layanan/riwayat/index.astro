---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { fetchAPI } from "@/lib/api";
import { RiwayatTable } from "./_components/riwayat-table";
import { PlusCircle } from "lucide-react";
import { getCurrentProfile } from "@/lib/auth";

const profile = await getCurrentProfile(Astro);
const userNip = profile?.email?.split("@")[0] || "";

let requests: any[] = [];
if (profile?.id) {
  try {
    const token = Astro.cookies.get("ptsp-auth")?.value || Astro.cookies.get("ptsp-auth-access-token")?.value;
    const authHeaders: Record<string, string> = {};
    if (token) {
      authHeaders["Authorization"] = `Bearer ${token}`;
      authHeaders["Cookie"] = `ptsp-auth=${token}`;
    }
    
    const res = await fetchAPI<any>(`/requests?user_id=${profile.id}`, {
      headers: { ...authHeaders }
    });
    
    // Parse date strings to Date objects for the UI table
    requests = (res?.data || []).map((req: any) => ({
      ...req,
      submittedAt: req.submittedAt ? new Date(req.submittedAt) : null,
      createdAt: req.createdAt ? new Date(req.createdAt) : new Date(),
      updatedAt: req.updatedAt ? new Date(req.updatedAt) : new Date(),
    }));
  } catch (e) {
    console.error("Failed to fetch requests:", e);
  }
}
---

<DashboardShell
  title="Riwayat Pengajuan | PTSP Kemenag Barito Utara"
  description="Lihat seluruh riwayat pengajuan layanan ASN Anda."
  mode="pegawai"
  userNip={userNip}
>
  <div class="space-y-5">
    <!-- Header Halaman Formal & Bersih -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h1 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
          Riwayat Pengajuan Layanan
        </h1>
        <p class="text-slate-500 dark:text-slate-400 mt-0.5 text-xs sm:text-sm font-medium">
          Daftar seluruh berkas permohonan layanan kepegawaian ASN yang pernah Anda ajukan.
        </p>
      </div>

      <a
        href="/pegawai/layanan/ajukan"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-emerald-700 hover:bg-emerald-800 text-white transition-colors shadow-xs self-start sm:self-auto"
      >
        <PlusCircle client:load className="h-3.5 w-3.5" />
        <span>Buat Pengajuan Baru</span>
      </a>
    </div>

    <!-- Tab Navigasi Standar (Border-b, Non-Floating) -->
    <div class="border-b border-slate-200 dark:border-slate-800 flex items-center gap-6 -mt-1 text-xs sm:text-sm">
      <a
        href="/pegawai/layanan/ajukan"
        class="pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 font-medium transition-colors"
      >
        Katalog Layanan ASN
      </a>
      <a
        href="/pegawai/layanan/riwayat"
        class="pb-3 border-b-2 border-emerald-600 text-emerald-700 dark:text-emerald-400 font-bold transition-colors"
      >
        Riwayat Pengajuan ({requests.length})
      </a>
    </div>

    <!-- Table & Filtering -->
    <RiwayatTable client:load requests={requests} />
  </div>
</DashboardShell>