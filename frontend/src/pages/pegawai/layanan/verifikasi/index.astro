---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { getVerifikasiCutiAtasan } from "@/lib/actions/pegawai/cuti-approval";
import { getCurrentProfile } from "@/lib/auth";
import VerifikasiClient from "./_components/verifikasi-client";

const result = await getVerifikasiCutiAtasan();

let error: string | null = null;
let pengajuanData: any[] = [];
let role: string | undefined;

if (result.error) {
  error = result.error;
} else {
  pengajuanData = result.data || [];
  role = (result as any).role;
}

const atasanProfile = await getCurrentProfile();
const pejabatList: any[] = [];

const userNip = atasanProfile?.email?.split("@")[0] || "";
---

<DashboardShell
  title="Verifikasi Pengajuan Cuti | PTSP Kemenag Barito Utara"
  description="Verifikasi pengajuan cuti pegawai di unit kerja Anda."
  mode="pegawai"
  userNip={userNip}
>
  {error ? (
    <div class="flex items-center justify-center min-h-[400px]">
      <div class="bg-red-50 text-red-600 px-6 py-4 rounded-xl border border-red-100 font-medium">
        {error}
      </div>
    </div>
  ) : (
    <div class="space-y-6">
      <!-- Header -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm px-6 py-5 flex items-center gap-4">
        <div class="h-10 w-10 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round">
            <path d="M9 11l3 3L22 4" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-900">
            {role === "Pejabat Berwenang" ? "Verifikasi Pengajuan Cuti (Kepala Kantor)" : "Verifikasi Pengajuan Cuti"}
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Kelola dan berikan persetujuan untuk pengajuan cuti pegawai.
          </p>
        </div>
      </div>

      <VerifikasiClient
        client:load
        initialData={pengajuanData}
        atasanProfile={atasanProfile}
        pejabatList={pejabatList}
        viewerRole={role}
      />
    </div>
  )}
</DashboardShell>