---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { getCurrentUser, getCurrentProfile } from "@/lib/auth";
import { getLaporanKinerjaAction } from "@/lib/actions/pegawai/e-lk";
import { format } from "date-fns";
import { id } from "date-fns/locale";
import { Button } from "@/components/ui/button";
import { Edit, Eye, Clock, CheckCircle2, XCircle, FileText, Link as LinkIcon, Trash2 } from "lucide-react";
import { DeleteButton } from "./_components/delete-button";

const user = await getCurrentUser();

let riwayat: any[] = [];
if (user) {
  const { data } = await getLaporanKinerjaAction(user.id);
  riwayat = data || [];
}

const profile = await getCurrentProfile();
const userNip = profile?.email?.split("@")[0] || "";
---

<DashboardShell
  title="Riwayat & Bukti E-LK Harian"
  description="Lihat seluruh riwayat laporan kinerja harian beserta status dan buktinya."
  mode="pegawai"
  userNip={userNip}
>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Riwayat & Bukti E-LK Harian</h1>
      <p class="text-slate-500 mt-1">Lihat seluruh riwayat laporan kinerja harian beserta status dan buktinya.</p>
    </div>

    <div class="border border-slate-200 shadow-sm overflow-hidden bg-white rounded-3xl">
      <div class="p-0">
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="text-xs text-slate-500 uppercase bg-slate-50/80 border-b border-slate-200">
              <tr>
                <th class="px-6 py-4 font-bold">Tanggal</th>
                <th class="px-6 py-4 font-bold w-1/3">Kegiatan & Hasil</th>
                <th class="px-6 py-4 font-bold text-center">Bukti</th>
                <th class="px-6 py-4 font-bold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {riwayat && riwayat.length > 0 ? (
                riwayat.map((lkh) => (
                  <tr key={lkh.id} class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap font-medium text-slate-700">
                      {format(new Date(lkh.tanggal), "d MMM yyyy", { locale: id })}
                    </td>
                    <td class="px-6 py-4">
                      <p class="font-semibold text-slate-800 mb-1">{lkh.kegiatanTugasJabatan}</p>
                      <p class="text-xs text-slate-500">Hasil: {lkh.hasil}</p>
                      {lkh.komentarPimpinan && (
                        <div class="mt-2 p-2 bg-amber-50 border border-amber-100 rounded-md text-xs text-amber-800">
                          <strong>Catatan Pimpinan:</strong> {lkh.komentarPimpinan}
                        </div>
                      )}
                    </td>
                    <td class="px-6 py-4 text-center">
                      {lkh.buktiDukungUrl ? (
                        <a href={lkh.buktiDukungUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 rounded-full hover:bg-blue-100 transition-colors">
                          <LinkIcon client:load class="h-3.5 w-3.5" /> Lihat Bukti
                        </a>
                      ) : (
                        <span class="text-xs text-slate-400 italic">-</span>
                      )}
                    </td>
                    <td class="px-6 py-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a href={`/pegawai/e-lk/isi?id=${lkh.id}`}>
                          <Button client:load size="sm" variant="outline" class="h-8 px-2 text-blue-600 border-blue-200 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-300">
                            <Edit class="h-4 w-4" />
                          </Button>
                        </a>
                        <DeleteButton client:load id={lkh.id} />
                      </div>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colSpan={4} class="px-6 py-12 text-center">
                    <div class="flex flex-col items-center justify-center text-slate-500">
                      <FileText client:load class="h-10 w-10 text-slate-300 mb-3" />
                      <p class="font-medium text-slate-700 mb-1">Belum Ada Riwayat LKH</p>
                      <p class="text-sm">Anda belum mengisi laporan kinerja harian.</p>
                    </div>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</DashboardShell>