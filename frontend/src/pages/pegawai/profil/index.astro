---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { requireAuth, getCurrentProfile } from "@/lib/auth";
import { ProfileClient } from "./_profile-client";
import { User } from "lucide-react";

await requireAuth(false, Astro);
const profile = await getCurrentProfile();
const userNip = profile?.email?.split("@")[0] || "";
---

<DashboardShell
  title="Profil Pegawai | PTSP Kemenag Barito Utara"
  description="Kelola informasi data diri, avatar, dan keamanan akun Anda."
  mode="pegawai"
  userNip={userNip}
>
  <div class="space-y-4 sm:space-y-6 animate-in fade-in slide-in-from-bottom-3 duration-300">
    <!-- Header Ringkas -->
    <div class="border-b border-slate-200/80 dark:border-slate-800 pb-3.5 sm:pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="inline-flex items-center gap-1.5 sm:gap-2 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/50 px-2.5 py-0.5 sm:px-3 sm:py-0.5 text-[10px] sm:text-[11px] font-extrabold text-emerald-700 dark:text-emerald-300 mb-1.5 sm:mb-2">
          <User className="h-3 w-3 sm:h-3.5 sm:w-3.5" />
          <span>Pengaturan Akun & Data Diri</span>
        </div>
        <h1 class="text-lg sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          Profil Pegawai
        </h1>
        <p class="text-slate-500 dark:text-slate-400 mt-0.5 text-xs sm:text-sm max-w-xl font-medium leading-relaxed">
          Kelola informasi data diri, avatar, dan keamanan akun Anda.
        </p>
      </div>
    </div>

    <ProfileClient client:load profile={profile} />
  </div>
</DashboardShell>