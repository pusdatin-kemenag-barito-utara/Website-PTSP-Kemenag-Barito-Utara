{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/lib/next-compat/link"],
      "next/image": ["./src/lib/next-compat/image"],
      "next/navigation": ["./src/lib/next-compat/navigation"],
      "next/cache": ["./src/lib/next-compat/cache"],
      "next/dynamic": ["./src/lib/next-compat/dynamic"],
      "next/font/google": ["./src/lib/next-compat/font-google"],
      "next/server": ["./src/lib/next-compat/server"]
    },
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "target": "ES2022",
    "types": ["astro/client", "vite/client", "node", "vite-plugin-pwa/client"],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "include": ["src/env.d.ts", "src/**/*", "astro.config.mjs"]
}