# Monorepo Root .gitignore

# Dependencies
node_modules/
**/node_modules/

# Next.js & Frontend Build Outputs
.next/
**/frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.cache/
frontend/.turbo/
frontend/.vercel/
*.tsbuildinfo
.cache/

# PWA Service Worker Generated Files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map

# Golang & Backend Build Outputs & Hot Reload Logs
backend/tmp/
backend/*.exe
backend/*.dll
backend/*.so
backend/*.dylib
backend/bin/
backend/main
backend/build-errors.log
*.log
main

# Environment Variables & Secrets
.env
.env*
!.env.example
*.env
*.env.local

# Temporary Scratch Files & Utility Scripts
scratch/
**/scratch/
scripts/
**/scripts/
frontend/scratch/
frontend/scripts/

# IDE & OS System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db

# AI Assistants, Internal Caches & Workspace Metadata
.claude/
.opencode/
.antigravitycli/
.gemini/
.agents/
